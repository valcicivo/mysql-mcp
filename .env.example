# Database Configuration (use localhost when using SSH tunnel)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=database_name

# SSH Tunnel Configuration
SSH_HOST=your.server.com
SSH_PORT=22
SSH_USER=username
SSH_KEY_PATH=/path/to/ssh/key
SSH_LOCAL_PORT=33061
# Tunnel destination as seen from the SSH server (default: localhost:3306).
# Set to 127.0.0.1 if the server only permits forwarding to 127.0.0.1 (e.g. permitopen="127.0.0.1:3306").
# SSH_DST_HOST=localhost
# SSH_DST_PORT=3306
